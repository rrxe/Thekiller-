# =====================================
# ODDXS SERVER  (copy to .env  — never commit the real file)
# =====================================
NODE_ENV=production
PORT=3000

# ---- Supabase (new project) -------------------------------------------------
# 1) Create a new Supabase project  2) SQL Editor → paste sql/oddxs_full.sql → Run
# 3) Project Settings → API → copy the URL and the *service_role* key (server only!)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- Telegram bot (create a NEW bot in @BotFather for ODDXS) -----------------
# The token MUST belong to the bot that opens this Mini App (initData is signed with it).
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN
BOT_USERNAME=your_oddxs_bot
# Short name of the Mini App if you made one with /newapp (leave empty when using the bot's Main Mini App)
BOT_APP_SHORT_NAME=
# Public HTTPS URL where this server runs (no trailing slash) — the webhook is registered automatically
WEBAPP_URL=https://your-domain.com
TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# ---- Admin panel (/admin) ----------------------------------------------------
# Long random secret — enter it on https://your-domain.com/admin   (openssl rand -hex 32)
ADMIN_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Optional: a chat/channel/user ID that receives a Telegram message for every new withdrawal request
# (use your own numeric Telegram ID, or a private group ID like -100123456789; the bot must be able to message it)
ADMIN_NOTIFY_CHAT_ID=
# Public channel that gets a "WITHDRAWAL APPROVED" post for every paid withdrawal (@channel or -100…; bot must be admin there).
# Can also be set in /admin → Settings → General.
PAYMENT_CHANNEL_ID=

# ---- Ads (AdsGram) -----------------------------------------------------------
# Task block  task-59461  (native task)   |   Interstitial block  int-59439  (set in the frontend)
# Reward URL to set in partner.adsgram.ai for the task block:
#   https://YOUR-DOMAIN/api/auth/me?userid=[userId]&secret=<ADSGRAM_REWARD_SECRET>&kind=native_task
ADSGRAM_REWARD_SECRET=CHANGE_ME_openssl_rand_hex_16
