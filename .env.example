# توكن البوت من BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# رابط HTTPS العام الذي سيصل من خلاله المستخدمون للتطبيق
# (نفس الدومين الذي تربطه بهذا التطبيق في Dokploy)
WEBAPP_URL=https://stormy.example.com

# رابط قناة تيليجرام الخاصة بمهمة "انضمام للقناة" داخل التطبيق
CHANNEL_URL=https://t.me/your_channel

# المنفذ الداخلي للسيرفر (Dokploy يمرر الترافيك من الدومين إلى هذا المنفذ)
PORT=3000
